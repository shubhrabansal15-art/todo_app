# =============================================
# TASKFLOW BACKEND — Environment Configuration
# =============================================

# DATABASE
# Local development: mysql+pymysql://user:pass@localhost:3306/taskflow
# Production (Supabase): postgresql://postgres.<ref>:<password>@<host>:6543/postgres?sslmode=require
DATABASE_URL=

# JWT
# REQUIRED: JWT signing secret — generate a strong random string for production
# Server will FAIL TO START if this is not set
JWT_SECRET=

# CORS
# Comma-separated list of allowed frontend origins for CORS
# Local: http://localhost:5173
# Production: https://<your-vercel-app>.vercel.app
FRONTEND_URL=http://localhost:5173
